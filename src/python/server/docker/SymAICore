# Use an official Python runtime as a parent image
FROM python:3.12-slim
#voumes
VOLUME /properties 
VOLUME /logdir
VOLUME /tmpdir
# Set the working directory in the container
WORKDIR /app
# Copy the current directory contents into the container at /app
COPY ./symaicore.py /app/symaicore.py
COPY ./symaiconfig.py /app/symaiconfig.py
COPY ./symaicommands.py /app/symaicommands.py
COPY ./symaicorecommands.py /app/symaicorecommands.py

# Install any needed dependencies specified in requirements.txt
RUN pip3 install websockets
#RUN pip3 install --no-cache-dir -r requirements.txt
# Make port 12345 available to the world outside this container
EXPOSE 12345
# Run symaicore.py when the container launches
CMD ["python", "symaicore.py"]
