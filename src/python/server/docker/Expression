# Use an official Python runtime as a parent image
FROM python:3.12-slim
#voumes
VOLUME /properties 
VOLUME /logdir
# Set the working directory in the container
WORKDIR /app
# Copy the current directory contents into the container at /app
COPY ./expression.py /app/expression.py
COPY ./symaiconfig.py /app/symaiconfig.py
COPY ./symaicommands.py /app/symaicommands.py
COPY ./symaiexpressioncommands.py /app/symaiexpressioncommands.py
COPY ./symbolicexpressiongrammarerrorlistener.py /app/symbolicexpressiongrammarerrorlistener.py
COPY ./treeutils.py /app/treeutils.py
COPY ./behvisitor.py /app/behvisitor.py
COPY ./exprvisitor.py /app/exprvisitor.py
COPY ./eqextractvisitor.py /app/eqextractvisitor.py
COPY ./BehaviorsGrammar/BehaviorsGrammarLexer.py /app/BehaviorsGrammar/BehaviorsGrammarLexer.py
COPY ./BehaviorsGrammar/BehaviorsGrammarListener.py /app/BehaviorsGrammar/BehaviorsGrammarListener.py
COPY ./BehaviorsGrammar/BehaviorsGrammarParser.py /app/BehaviorsGrammar/BehaviorsGrammarParser.py
COPY ./BehaviorsGrammar/BehaviorsGrammarVisitor.py /app/BehaviorsGrammar/BehaviorsGrammarVisitor.py
COPY ./coreexprgrammarlistener.py /app/coreexprgrammarlistener.py
COPY ./symaiexpr.py /app/symaiexpr.py
COPY ./symaiexprcvc5.py /app/symaiexprcvc5.py
COPY ./symaiexprz3.py /app/symaiexprz3.py
COPY ./symaiexprsympy.py /app/symaiexprsympy.py
COPY ./symbolicexpressiongrammarvisitor.py /app/symbolicexpressiongrammarvisitor.py
COPY ./mathutils.py /app/mathutils.py
COPY ./ExpressionGrammar/ExpressionGrammarLexer.py /app/ExpressionGrammar/ExpressionGrammarLexer.py
COPY ./ExpressionGrammar/ExpressionGrammarListener.py /app/ExpressionGrammar/ExpressionGrammarListener.py
COPY ./ExpressionGrammar/ExpressionGrammarParser.py /app/ExpressionGrammar/ExpressionGrammarParser.py
COPY ./ExpressionGrammar/ExpressionGrammarVisitor.py /app/ExpressionGrammar/ExpressionGrammarVisitor.py
COPY ./bash/run.sh /app/run.sh

# Install any needed dependencies specified in requirements.txt
RUN pip3 install sympy antlr4-python3-runtime cvc5 z3-solver
# RUN pip3 install --no-cache-dir -r requirements.txt
# Make port 8080 available to the world outside this container
EXPOSE 8080
# Run app.py when the container launches
CMD ["bash", "run.sh", "python", "expression.py"]
