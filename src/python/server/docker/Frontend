FROM nginx:latest
# Find a NGINX conf file and replace it with ours
RUN cp ./resources/nginx-conf/nginx.conf $(nginx -V 2>&1 | grep -o '\-\-conf-path=\(.*conf\)' | cut -d '=' -f2)
RUN cp ./resources/nginx-cong/default /etc/nginx/sites-available/
# exact location of NGINX Web Root defined in the config. Let it be /usr/share/nginx/html
COPY ./resources/client/dist/app2/browser /usr/share/nginx/html

