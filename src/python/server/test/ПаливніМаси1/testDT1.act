getWaterMassData1: 1 -> waterMass_flowRate = 2*(1/POW(10,6)); waterMass_evaporationRate = 3*(1/POW(10,6)),
getWaterMassData2: 1 -> waterMass_mass = waterMass_mass0,
getFuelMassData1: 1 -> fuelMass_macroFissCrossSect = 1/POW(10,2); fuelMass_averVelosityThN = POW(10,5),
getFuelMassData2: 1 -> fuelMass_reactivity = fuelMass_reactivity0; fuelMass_neutronNum0 = fuelMass_nSourcePow*fuelMass_tConst/fuelMass_reactivity0; fuelMass_neutronNum = fuelMass_nSourcePow*fuelMass_tConst/fuelMass_reactivity0; fuelMass_densityN = (fuelMass_nSourcePow*fuelMass_tConst/fuelMass_reactivity0)*fuelMass_averVelosityThN,
getNewMassW: 1 -> waterMass_mass = waterMass_flowRate*time,
getD: 1 -> d = -1*((fuelMass_reactivity0*time)/(fuelMass_tConst * waterMass_mass1 * waterMass_mass2))*(POW((waterMass_flowRate*time),2) - (waterMass_mass1 + waterMass_mass2) * waterMass_flowRate * time + waterMass_mass1 * waterMass_mass2),
getNewN: 1 -> fuelMass_neutronNum = ((fuelMass_nSourcePow * fuelMass_tConst * waterMass_mass1 * waterMass_mass2)/(fuelMass_reactivity0 * (POW((waterMass_flowRate*time),2) - (waterMass_mass1 + waterMass_mass2) * waterMass_flowRate * time + waterMass_mass1* waterMass_mass2)))*(1 - POW(eConst,d)),
getNewNdensity: 1 -> fuelMass_densityN = fuelMass_neutronNum*fuelMass_averVelosityThN,
doMonitoring: time <= monitoringTime -> 1,
setNewTime: 1 -> time = time + 5000,
stopMonitoring: time > monitoringTime -> 1,