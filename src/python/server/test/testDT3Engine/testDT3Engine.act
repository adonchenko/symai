checkCycleNum: engCycleNum <= engineCyclesNum -> 1,
newCycle: 1 -> engCycleNum = engCycleNum+1; crankshaftRotationAngle = initialCrankshaftRotationAngle,
notCheckCycleNum: engCycleNum > engineCyclesNum -> 1,
checkCrankshaftRotationAngle: crankshaftRotationAngle <= 360 -> 1,
changeCrankshaftRotationAngle1: 1 -> crankshaftRotationAngle = crankshaftRotationAngle + dCrankshaftRotationAngle; time = time + 1,
notCheckCrankshaftRotationAngle: crankshaftRotationAngle > 360 -> 1,

isStroke1: crankshaftRotationAngle >= -360 && crankshaftRotationAngle <= -180 -> 1,

getAirDensityInInlet: 1 -> air_density = pressureInInletValve/(air_gasConstant*air_temperatureInInletValve),
getSubstanceVelocityFromInletValveA: 1 -> air_velocityInInletValve=POW(2*(air_heatCapacityRatio/(air_heatCapacityRatio-1))*air_gasConstant*air_temperatureInInletValve*(1-POW(pressureInCylinder/pressureInInletValve,((air_heatCapacityRatio-1)/air_heatCapacityRatio))),0.5),
getInletValveCrossSectionalAreaOpen: 1 -> inletValveCrossSectionalArea = 0.5*maxInletValveCrossSectionalArea*(1 - cos(((crankshaftRotationAngle-inletValveOpenAngle)/(inletValveOpenDuration + correctionAngle))*180)),
getExhaustValveCrossSectionalAreaClose: exhaustValveCloseAngle > crankshaftRotationAngle -> exhaustValveCrossSectionalArea = 0.5*maxExhaustValveCrossSectionalArea*(1 + cos(((crankshaftRotationAngle-exhaustValveCloseAngle)/(exhaustValveCloseDuration+correctionAngle))*180)),
notGetExhaustValveCrossSectionalAreaClose: exhaustValveCloseAngle <= crankshaftRotationAngle -> exhaustValveCrossSectionalArea = 0,

getCylinderWallSurfaceArea: 1 -> cylinderWallSurfaceArea = piConst* cylinderDiameter* 0.5* pistonStroke*((1 - cos(crankshaftRotationAngle*piConst/180 )) + (pistonStroke/(8*connectingRodLength))*(1-cos(2*crankshaftRotationAngle*piConst/180))),
getHeatTransferCoef: 1 -> heatTransferCoefficient = 128*POW(cylinderDiameter,-0.2)*POW(6.18*averagePistonSpeed,0.8)*POW(POW(10,-5)*pressureInCylinder,0.8)*POW(temperatureInCylinder,-0.53),
getHeatTransferredAmount: 1 -> dHeatTransferAmount = heatTransferCoefficient*(pistonArea*(temperatureInCylinder - pistonTemperature) + cylinderHeadArea*(temperatureInCylinder - cylinderHeadTemperature) + cylinderWallSurfaceArea*(temperatureInCylinder - cylinderWallSurfaceTemperature))*(dCrankshaftRotationAngle*(piConst/180)/(6*crankshaftRotationFrequency)),

getCylinderSupraPistonVolumeNew: 1 -> cylinderSupraPistonVolumeNew = combustionChamberVolume + piConst*(POW(cylinderDiameter,2)/4)*(POW(POW((crankRadius+connectingRodLength),2)-POW(crankOffsetLength,2),0.5)  - POW(POW(connectingRodLength,2)- POW((crankOffsetLength + crankRadius*sin((crankshaftRotationAngle-crankCorrectionAngle)*piConst/180)),2),0.5) - crankRadius*cos((crankshaftRotationAngle-crankCorrectionAngle)*piConst/180)),
getCylinderSupraPistonVolumeDelta: 1 -> dCylinderSupraPistonVolume = cylinderSupraPistonVolumeNew - cylinderSupraPistonVolume; workingMixture_volumeInCylinder = cylinderSupraPistonVolumeNew,

isIntakeCase1: (crankshaftRotationAngle < exhaustValveCloseAngle) && pressureInInletValve >= pressureInCylinder && pressureInCylinder > pressureInExhaustValve && combustionProducts_massInCylinder > 0 -> workingMixture_volumeInCylinder = cylinderSupraPistonVolumeNew,
getSubstanceMassFromInletA: 1 -> air_dMassFromInletValve = air_density*POW((pressureInCylinder/pressureInInletValve),(1/air_heatCapacityRatio))*inletValveCrossSectionalArea*air_velocityInInletValve*(dCrankshaftRotationAngle*(piConst/180)/(6*crankshaftRotationFrequency)),
getSubstanceParametersInCylinder1: air_massInCylinder > 0 -> workingMixture_heatCapacityRatio = (air_heatCapacityRatio + combustionProducts_heatCapacityRatio)/2; workingMixture_gasConstant = (air_gasConstant+combustionProducts_gasConstant)/2,
getSubstanceParametersInCylinder2: air_massInCylinder <= 0 -> workingMixture_heatCapacityRatio = combustionProducts_heatCapacityRatio; workingMixture_gasConstant = combustionProducts_gasConstant,
getSubstanceDensityInCylinder: 1 -> workingMixture_density = pressureInCylinder/(workingMixture_gasConstant*temperatureInCylinder); workingMixture_temperatureInCylinder = temperatureInCylinder,
getSubstanceVelocityToExhaustValveWM: 1 -> workingMixture_velocityInExhaustValve = POW(2*(workingMixture_heatCapacityRatio/(workingMixture_heatCapacityRatio-1))*workingMixture_gasConstant*temperatureInCylinder*(1-POW(pressureInExhaustValve/pressureInCylinder,((workingMixture_heatCapacityRatio-1)/workingMixture_heatCapacityRatio))),0.5),
getSubstanceMassToExhaustWM: 1 -> workingMixture_dMassFromCylinderToExh = workingMixture_density*POW((pressureInExhaustValve/pressureInCylinder),(1/workingMixture_heatCapacityRatio))*exhaustValveCrossSectionalArea*workingMixture_velocityInExhaustValve*(dCrankshaftRotationAngle*(piConst/180)/(6*crankshaftRotationFrequency)),
getPressureInCylinder1: 1 -> dPressureInCylinder = (workingMixture_heatCapacityRatio*pressureInCylinder/workingMixture_volumeInCylinder)*((workingMixture_gasConstant*temperatureInCylinder/pressureInCylinder)*(air_dMassFromInletValve*(air_temperatureInInletValve/temperatureInCylinder) - workingMixture_dMassFromCylinderToExh) - ((workingMixture_heatCapacityRatio-1)/workingMixture_heatCapacityRatio)*(dHeatTransferAmount/pressureInCylinder) - dCylinderSupraPistonVolume),
recalculateIntakeParameters1: 1 -> pressureInCylinder = pressureInCylinder + dPressureInCylinder; workingMixture_massInExhaustValve = workingMixture_massInExhaustValve - workingMixture_dMassFromCylinderToExh; combustionProducts_massInCylinder = combustionProductsMass - (workingMixture_massInExhaustValve - workingMixture_dMassFromCylinderToExh); air_massInCylinder = air_massInCylinder + air_dMassFromInletValve; workingMixture_massInCylinder = workingMixture_massInCylinder + air_dMassFromInletValve - workingMixture_dMassFromCylinderToExh; heatTransferAmount = heatTransferAmount + dHeatTransferAmount; cylinderSupraPistonVolume = cylinderSupraPistonVolumeNew; pressureInInletValve = pressureInInletValve + dPressureInInletValve; air_massInInletValve = air_massInInletValve - air_dMassFromInletValve,

isIntakeCase2: (crankshaftRotationAngle < exhaustValveCloseAngle) && pressureInInletValve >= pressureInCylinder && pressureInCylinder > pressureInExhaustValve && combustionProducts_massInCylinder <= 0 -> workingMixture_volumeInCylinder = cylinderSupraPistonVolumeNew,
getSubstanceParametersInCylinder3: 1 -> workingMixture_heatCapacityRatio = air_heatCapacityRatio; workingMixture_gasConstant = air_gasConstant,
getPressureInCylinder2: 1 -> dPressureInCylinder = (air_heatCapacityRatio*pressureInCylinder/workingMixture_volumeInCylinder)*((air_gasConstant*temperatureInCylinder/pressureInCylinder)*(air_dMassFromInletValve - workingMixture_dMassFromCylinderToExh) - ((air_heatCapacityRatio-1)/air_heatCapacityRatio)*(dHeatTransferAmount/pressureInCylinder) - dCylinderSupraPistonVolume),
recalculateIntakeParameters2: 1 -> pressureInCylinder = pressureInCylinder + dPressureInCylinder; workingMixture_massInExhaustValve = workingMixture_massInExhaustValve + workingMixture_dMassFromCylinderToExh; air_massInCylinder = air_massInCylinder + air_dMassFromInletValve; workingMixture_massInCylinder = workingMixture_massInCylinder + air_dMassFromInletValve - workingMixture_dMassFromCylinderToExh; cylinderSupraPistonVolume = cylinderSupraPistonVolumeNew; heatTransferAmount = heatTransferAmount + dHeatTransferAmount; pressureInInletValve = pressureInInletValve + dPressureInInletValve; air_massInInletValve = air_massInInletValve - air_dMassFromInletValve,

isIntakeCase3: (crankshaftRotationAngle > exhaustValveCloseAngle) && pressureInInletValve >= pressureInCylinder -> workingMixture_volumeInCylinder = cylinderSupraPistonVolumeNew,
getPressureInCylinder3: 1 -> dPressureInCylinder = (air_heatCapacityRatio*pressureInCylinder/workingMixture_volumeInCylinder)*((air_gasConstant*temperatureInCylinder/pressureInCylinder)*(air_dMassFromInletValve) - ((air_heatCapacityRatio-1)/air_sheatCapacityRatio)*(dHeatTransferAmount/pressureInCylinder) - dCylinderSupraPistonVolume),
recalculateIntakeParameters3: 1 -> pressureInCylinder = pressureInCylinder + dPressureInCylinder; air_massInCylinder = air_massInCylinder + air_dMassFromInletValve; workingMixture_massInCylinder = workingMixture_massInCylinder + air_dMassFromInletValve; heatTransferAmount = heatTransferAmount + dHeatTransferAmount; cylinderSupraPistonVolume = cylinderSupraPistonVolumeNew; pressureInInletValve = pressureInInletValve + dPressureInInletValve; air_massInInletValve = air_massInInletValve - air_dMassFromInletValve,
getWorkStroke1T1: temperatureInCylinder<=900 -> gasWorkStrike1 = gasWorkStrike1 + (pressureInCylinder + 0.5*dPressureInCylinder)*dCylinderSupraPistonVolume,
getWorkStroke1T2: temperatureInCylinder>900 -> 1,

isIntakeCase4: (crankshaftRotationAngle > exhaustValveCloseAngle) && pressureInInletValve < pressureInCylinder -> workingMixture_volumeInCylinder = cylinderSupraPistonVolumeNew,
getSubstanceVelocityToInletValveWM: 1 -> workingMixture_velocityInInletValve=POW(2*(workingMixture_heatCapacityRatio/(workingMixture_heatCapacityRatio-1))*workingMixture_gasConstant*workingMixture_temperatureInInletValve*(1-POW(pressureInInletValve/pressureInCylinder,((workingMixture_heatCapacityRatio-1)/workingMixture_heatCapacityRatio))),0.5),
getSubstanceMassToInletWM: 1 -> workingMixture_dMassFromCylinderToInl = workingMixture_density*POW((pressureInInletValve/pressureInCylinder),(1/workingMixture_heatCapacityRatio))*inletValveCrossSectionalArea*workingMixture_velocityInInletValve*(dCrankshaftRotationAngle*(piConst/180)/(6*crankshaftRotationFrequency)),
getPressureInCylinder4: 1 -> dPressureInCylinder = (workingMixture_heatCapacityRatio*pressureInCylinder/workingMixture_volumeInCylinder)*((workingMixture_gasConstant*temperatureInCylinder/pressureInCylinder)*((-1) * workingMixture_dMassFromCylinderToInl) - ((workingMixture_heatCapacityRatio-1)/workingMixture_heatCapacityRatio)*(dHeatTransferAmount/pressureInCylinder) - dCylinderSupraPistonVolume),
recalculateIntakeParameters4: 1 -> pressureInCylinder = pressureInCylinder + dPressureInCylinder; air_massInCylinder = air_massInCylinder - workingMixture_dMassFromCylinderToInl; workingMixture_massInCylinder = workingMixture_massInCylinder - workingMixture_dMassFromCylinderToInl; heatTransferAmount = heatTransferAmount + dHeatTransferAmount; cylinderSupraPistonVolume = cylinderSupraPistonVolumeNew; pressureInInletValve = pressureInInletValve + dPressureInInletValve; air_massInInletValve = air_massInInletValve + workingMixture_dMassFromCylinderToInl,

isIntakeCase5: (crankshaftRotationAngle < exhaustValveCloseAngle) && pressureInInletValve >= pressureInCylinder && pressureInCylinder < pressureInExhaustValve -> workingMixture_volumeInCylinder = cylinderSupraPistonVolumeNew,
getSubstanceVelocityFromExhValveWM: 1 ->  workingMixture_velocityInExhaustValve=POW(2*( workingMixture_heatCapacityRatio/( workingMixture_heatCapacityRatio-1))* workingMixture_gasConstant* workingMixture_temperatureInExhaustValve*(1-POW(pressureInCylinder/pressureInExhaustValve,(( workingMixture_heatCapacityRatio-1)/ workingMixture_heatCapacityRatio))),0.5),
getSubstanceMassFromExhaustWM: 1 -> workingMixture_dMassFromExhValve = workingMixture_density*POW((pressureInCylinder/pressureInInletValve),(1/workingMixture_heatCapacityRatio))*exhaustValveCrossSectionalArea*workingMixture_velocityInExhaustValve*(dCrankshaftRotationAngle*(piConst/180)/(6*crankshaftRotationFrequency)),
getPressureInCylinder5: 1 -> dPressureInCylinder = (workingMixture_heatCapacityRatio*pressureInCylinder/workingMixture_volumeInCylinder)*((workingMixture_gasConstant*temperatureInCylinder/pressureInCylinder)*(air_dMassFromInletValve + workingMixture_dMassFromExhValve) - ((workingMixture_heatCapacityRatio-1)/workingMixture_heatCapacityRatio)*(dHeatTransferAmount/pressureInCylinder) - dCylinderSupraPistonVolume),
recalculateIntakeParameters5: 1 -> pressureInCylinder = pressureInCylinder + dPressureInCylinder; workingMixture_massInExhaustValve = workingMixture_massInExhaustValve - workingMixture_dMassFromExhValve; air_massInCylinder = air_massInCylinder + air_dMassFromInletValve; workingMixture_massInCylinder = workingMixture_massInCylinder + air_dMassFromInletValve + workingMixture_dMassFromExhValve; heatTransferAmount = heatTransferAmount + dHeatTransferAmount; cylinderSupraPistonVolume = cylinderSupraPistonVolumeNew; pressureInInletValve = pressureInInletValve + dPressureInInletValve; air_massInInletValve = air_massInInletValve - air_dMassFromInletValve,

getTemperatureInCylinder: 1 -> temperatureInCylinder = pressureInCylinder*cylinderSupraPistonVolume/(workingMixture_massInCylinder*workingMixture_gasConstant),

getResidualGasesCoefficient: 1 -> residualGasesCoefficient = combustionProducts_massInCylinder/air_massInCylinder,
getWorkMixtureAmountInCylinder: 1 -> workingMixture_amountInCylinder = (workingMixture_massInCylinder*gasConstant*temperatureInCylinder)/(pressureInCylinder*workingMixture_volumeInCylinder); workingMixtureAmountInCylinderInletClose = (workingMixture_massInCylinder*gasConstant*temperatureInCylinder)/(pressureInCylinder*workingMixture_volumeInCylinder),
getAirAmountInCylinder: 1 -> air_amountInCylinder = workingMixture_amountInCylinder/(1 + residualGasesCoefficient),
getCombProdAmountInCylinder: 1 -> combustionProducts_amountInCylinder = air_amountInCylinder*residualGasesCoefficient; combustionProductsAmountInletClose = air_amountInCylinder*residualGasesCoefficient,
getPressureVolumeInletClose: 1 -> pressureInCylinderInletClose = pressureInCylinder; cylinderSupraPistonVolumeInletClose = cylinderSupraPistonVolume,
getCombustionProductsVolumeFraction2: 1 -> combustionProductsVolumeFraction = combustionProducts_amountInCylinder/(workingMixtureAmountInCylinderInletClose*(1 + (molecularChangeCoeff - 1) * fuelBurnedFraction)),

isStroke2: crankshaftRotationAngle > -180 && crankshaftRotationAngle <= 0 -> 1,

isStroke3: crankshaftRotationAngle > 0 && crankshaftRotationAngle <= 180 -> 1,

isStroke4: crankshaftRotationAngle > 180 && crankshaftRotationAngle <= 360 -> 1,

