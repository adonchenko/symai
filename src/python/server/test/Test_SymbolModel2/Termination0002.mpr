mscdocument Termination0002;
msc Termination0002;

MYAGENT#agent1:instance;

all: condition INITIAL /*$
k == 1 && 
c == 2 && 
1 <= b && 
b <= 3$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action1(MYAGENT#agent1) prot_no=0; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
a > b && 
c == a + b && 
1 <= b && 
b <= 3 && 
k == 1$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action3(MYAGENT#agent1) prot_no=1; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
(-2) * b + c > 0 && 
b <= 3 && 
1 <= b && 
a == 1 + b && 
k == 1$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action4(MYAGENT#agent1) prot_no=2; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
(-3) * b + c > 1 && 
1 <= b && 
b <= 3 && 
k == 2 && 
a == 1 + b$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action1(MYAGENT#agent1) prot_no=3; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
b <= 3 && 
1 <= b && 
a == 1 + b && 
c == 1 + 2 * b && 
k == 2$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action3(MYAGENT#agent1) prot_no=4; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
b <= 3 && 
1 <= b && 
a == 1 + b && 
c == 1 + 2 * b && 
k == 2$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action4(MYAGENT#agent1) prot_no=5; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
b <= 3 && 
1 <= b && 
k == 3 && 
a == 1 + b && 
c == 2 + 3 * b$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action1(MYAGENT#agent1) prot_no=6; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
b <= 3 && 
1 <= b && 
c == 1 + 2 * b && 
a == 1 + b && 
k == 3$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action5(MYAGENT#agent1) prot_no=7; local_vars=(UNDEFINED)$*/;

all: condition ENVIRONMENT /*$
k == 3 && 
b <= 3 && 
1 <= b && 
c == 1 + 2 * b && 
a == 1 + b$*/;

MYAGENT#agent1:condition BASIC_PROTOCOL /*$action6(MYAGENT#agent1) prot_no=8; local_vars=(UNDEFINED)$*/;

text 'Termination detected';
all: condition FINITE /*$
k == 3 && 
b <= 3 && 
1 <= b && 
c == 1 + 2 * b && 
a == 1 + b$*/;

MYAGENT#agent1:endinstance;
endmsc;
