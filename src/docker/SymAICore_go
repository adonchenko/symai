# --- Build Stage ---
FROM golang:1.23-alpine AS builder
# Installing cmake, make, jdk
RUN apk update
RUN apk add --no-cache cmake make gcc g++ make musl-dev openjdk17-jre
# Set the working directory in the container
WORKDIR /app
# Copy the current directory contents into the container at /app
RUN mkdir /app/etc
RUN mkdir /app/etc/cmake
COPY ./CMakeLists.txt /app/CMakeLists.txt
COPY ./etc/cmake/FindGo.cmake /app/etc/cmake
RUN mkdir /app/bin
COPY ./bin /app/bin
RUN mkdir /app/src
RUN mkdir /app/src/go
COPY ./src/antlr4/BehaviorsGrammar.g4 /app/src/antlr4/BehaviorsGrammar.g4

COPY ./src/go/server/config/config.go /app/src/go/server/config/config.go
COPY ./src/go/server/config/symaiformatter.go /app/src/go/server/config/symaiformatter.go

COPY ./src/go/server/utils/utils.go /app/src/go/server/utils/utils.go

COPY ./src/go/server/symaicore/symaicore.go /app/src/go/server/symaicore/symaicore.go

COPY ./src/go/server/symaicorecontroller/symaicorehub.go /app/src/go/server/symaicorecontroller/symaicorehub.go
COPY ./src/go/server/symaicorecontroller/symaicoreservercontroller.go /app/src/go/server/symaicorecontroller/symaicoreservercontroller.go
COPY ./src/go/server/symaicorecontroller/symaisymaicoreserver.go /app/src/go/server/symaicorecontroller/symaisymaicoreserver.go
COPY ./src/go/server/symaicorecontroller/symaicorecommands.go /app/src/go/server/symaicorecontroller/symaicorecommands.go
COPY ./src/go/server/symaicorecontroller/symaicoretools.go /app/src/go/server/symaicorecontroller/symaicoretools.go

COPY ./src/go/server/parser/error_processing.go /app/src/go/server/parser/error_processing.go
COPY ./src/go/server/parser/error_listener.go /app/src/go/server/parser/error_listener.go
COPY ./src/go/server/parser/eq_extractor_visitor.go /app/src/go/server/parser/eq_extractor_visitor.go
COPY ./src/go/server/parser/actions_visitor.go /app/src/go/server/parser/actions_visitor.go
COPY ./src/go/server/parser/behaviors_visitor.go /app/src/go/server/parser/behaviors_visitor.go
COPY ./src/go/server/parser/parser_common.go /app/src/go/server/parser/parser_common.go

# Build an executable
RUN mkdir /app/build
RUN cd /app/build
RUN cmake .
RUN make symai-symaicore-golang

# Stage 2: Create the final minimal image
FROM alpine:latest AS runner
#voumes
VOLUME /properties
VOLUME /logdir
VOLUME /tmpdir
#VOLUME /app/resources
WORKDIR /app
COPY --from=builder /app/build/release/symaicore /app/symaicore
EXPOSE 12345
CMD ["/app/symaicore"]
